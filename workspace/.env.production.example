# Copy to .env on the EC2 host. Placeholders only; never commit the real file.
DB_USER=pai_admin
DB_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
# DATABASE_URL is optional. Compose defaults it to the private postgres service
# using DB_USER and DB_PASSWORD.
WEB_CONCURRENCY=1
THREADPOOL_TOKENS=15
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=300
DB_PGBOUNCER=false

CORS_ORIGINS=https://app.placement-ai.com
WORKSPACE_ENDPOINT=https://api.placement-ai.com
FRONTEND_BASE_URL=https://app.placement-ai.com
PUBLIC_API_BASE=https://api.placement-ai.com

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=PLACEHOLDER

PAI_ENABLED=false
PAI_API_KEY=
PAI_MODEL=gpt-5.6-sol
PAI_BASE_URL=https://api.openai.com/v1

BROWSERFABRIC_API_KEY=
BROWSERFABRIC_URL=https://api.browserfabric.com
BROWSERFABRIC_PROVISION_SECRET=

REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5
REDIS_MAXMEMORY=256mb

MEMORY_VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pai_memory
MEMORY_EMBEDDING_PROVIDER=openai
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_DIM=1536
# Extraction decides what enters the Vault, so it is the one call that must be
# accurate rather than cheap. It runs in the background, once per turn, on a
# short prompt. Leave empty to reuse PAI_MODEL.
#
# Do NOT use gpt-4o here: that model is capped at 30,000 TPM on this account
# (measured), against 200k-500k for the gpt-5 family, and a single counselling
# session exhausts it. gpt-5.x also needs `max_completion_tokens` rather than
# `max_tokens` — handled in cloud_providers._token_limit_kwarg.
MEMORY_EXTRACTOR_MODEL=gpt-5.6-sol
# Upstream retries. A tokens-per-minute 429 otherwise reaches the student as
# "PAI could not reach the language service".
LLM_MAX_RETRIES=4
# Per-agent reasoning. On /v1/chat/completions any request carrying function
# tools accepts ONLY reasoning_effort="none" (measured: low/medium/high all
# return 400 "Function tools with reasoning_effort are not supported"), so:
#   - Counselor turns always carry tools -> pinned to "none" = fastest reply.
#     This value applies to its tool-free calls, such as the research handoff.
#   - Operator's UNDERSTAND/PLAN/VERIFY carry no tools and honour "high";
#     only its tool-execution loop is pinned to "none".
PAI_COUNSELOR_REASONING_EFFORT=low
PAI_OPERATOR_REASONING_EFFORT=high
# Empty reuses PAI_MODEL for Operator.
PAI_OPERATOR_MODEL=
# Retrieval deadline on the response-critical path. Only 70% of it goes to the
# hybrid (vector) arm, and a REMOTE embedding provider needs ~1s per query, so
# values near 1500 make vector retrieval time out on every turn and silently
# degrade to lexical search over canonical rows.
PAI_MEMORY_CONTEXT_TIMEOUT_MS=3000
# off | shadow | new | all
PAI_PROFILE_COMPLETION_ROLLOUT_MODE=shadow
# Required when mode=new, e.g. 2026-10-01T00:00:00Z
PAI_PROFILE_COMPLETION_ROLLOUT_AT=
MEMORY_SPARSE_MODEL=Qdrant/bm25
MEMORY_RETRIEVAL_CANDIDATES=40
MEMORY_RETRIEVAL_LIMIT=8

FILE_STORAGE_BACKEND=s3
S3_BUCKET=YOUR_BUCKET_NAME
S3_REGION=eu-north-1

JOB_WORKER_POLL_SECONDS=2
JOB_WORKER_CONCURRENCY=5

RESEND_API_KEY=
EMAIL_FROM=Placement AI <noreply@placement-ai.com>
FEEDBACK_EMAIL_TO=

WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

NEXT_PUBLIC_API_URL=https://api.placement-ai.com
NEXT_PUBLIC_ENABLE_DMS=false
NEXT_PUBLIC_ENABLE_INBOX=false
NEXT_PUBLIC_ENABLE_TASKS=false
NEXT_PUBLIC_ENABLE_WORKFLOWS=false
