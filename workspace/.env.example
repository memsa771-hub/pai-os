# Copy this file to .env for local development, then replace the placeholder
# locally. Never commit a real API key.
PAI_ENABLED=true
PAI_API_KEY=<PLACEHOLDER_DO_NOT_COMMIT_REAL_KEY>
PAI_MODEL=gpt-5.4-mini
PAI_BASE_URL=https://api.openai.com/v1

# Optional backend-only web search provider. Leave blank to disable safely.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

# Supabase Auth — required for human sign-in (web/desktop). SUPABASE_ANON_KEY
# is the public/publishable key (safe in a client bundle, not a secret) —
# still fill in your own project's values rather than committing real ones.
# Read by the backend directly; passed to the frontend build as
# NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY (see docker-compose.yml).
SUPABASE_URL=<YOUR_PROJECT>.supabase.co
SUPABASE_ANON_KEY=<PLACEHOLDER_SUPABASE_ANON_KEY>

# Optional Redis cache/PubSub used by Docker Compose. All data is disposable;
# PostgreSQL remains canonical. Leave REDIS_URL blank outside Compose to disable.
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5
REDIS_MAXMEMORY=256mb

# Surfaces held back for a later Placement AI release. The implementations
# stay in the codebase; these flags decide whether the web and desktop builds
# show them. Set to true to bring one back.
NEXT_PUBLIC_ENABLE_DMS=false
NEXT_PUBLIC_ENABLE_INBOX=false
