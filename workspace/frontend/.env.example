# Workspace web env vars.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so on
# Vercel they must be set in Project → Settings → Environment Variables and a
# redeploy is required for changes to take effect.

# Backend API base. Defaults to Placement AI's hosted API when unset — see
# lib/config.ts, which is the single place that origin is written.
#   production   https://api.placement-ai.com
#   development  http://localhost:8000  (docker-compose passes this already)
# NEXT_PUBLIC_API_URL=https://api.placement-ai.com

# Supabase Auth — required for human sign-in. The anon key is the public/
# publishable key (safe in a client bundle, not a secret) — still use your
# own project's values, never commit real ones here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics — leave unset to disable (the snippets are skipped entirely).
# PostHog project (client) API key — the phc_... value from PostHog project settings.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host (optional; defaults to https://d.openagents.org).
# NEXT_PUBLIC_POSTHOG_HOST=https://d.openagents.org
# Google Analytics measurement ID (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
